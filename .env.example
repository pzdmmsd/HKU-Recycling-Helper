# Group 73 / AILT9019. Keep your real key in .env, never in source code.
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA text model; re-evaluate behavior after changing models.
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.1
# Source approval is checked separately for every rule and source.
# Optional exact custom domains, comma-separated, without https:// or paths.
# Vercel deployment, production and branch URLs are detected automatically.
ALLOWED_HOSTS=
